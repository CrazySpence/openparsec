; Test con for box.od2 -- generated by makeodt from box.obj
;
; Files to copy into your game data folder:
;   box.od2        (from this folder)
;   grey.tga       (from this folder -- used as stand-in since box.tga doesn't exist yet)
;                  (swap in any TGA you want and update the 'file' line below)
;
; To use: exec box.con  (from the in-game console)
; Then select "testbox" in the ship select screen.

write loading test: box...

load texture box.tga    file grey.tga
load object (testbox)   file box.od2 type ship_1

; mon_f1 is the HUD ship-select icon -- reusing firebird's since we have no custom icon
shipclass class (testbox) texture mon_f1
shipclass class (testbox)

shipdesc class (testbox) caption testbox

propc (testbox).maxdamage     50
propc (testbox).energy       400
propc (testbox).maxenergy    850
propc (testbox).weapons      257
propc (testbox).maxspeed   66000
propc (testbox).dumb           0
propc (testbox).maxdumb        3
propc (testbox).guide          0
propc (testbox).maxguide       5
propc (testbox).swarm          0
propc (testbox).maxswarm       2
propc (testbox).mines          0
propc (testbox).maxmines      10

propc (testbox).laser1.x1     -5.0
propc (testbox).laser1.x2     -1.0
propc (testbox).laser1.x3      1.0
propc (testbox).laser1.x4      5.0
propc (testbox).laser1.y1      0.0
propc (testbox).laser1.y2      0.0
propc (testbox).laser1.y3      0.0
propc (testbox).laser1.y4      0.0
propc (testbox).laser1.z1     30.0
propc (testbox).laser1.z2     30.0
propc (testbox).laser1.z3     30.0
propc (testbox).laser1.z4     30.0

propc (testbox).missile1.x1   -9.0
propc (testbox).missile1.x2   -5.0
propc (testbox).missile1.x3    5.0
propc (testbox).missile1.x4    9.0
propc (testbox).missile1.y1    0.0
propc (testbox).missile1.y2    0.0
propc (testbox).missile1.y3    0.0
propc (testbox).missile1.y4    0.0
propc (testbox).missile1.z1   18.0
propc (testbox).missile1.z2   18.0
propc (testbox).missile1.z3   18.0
propc (testbox).missile1.z4   18.0

;eof
