; Test con for dralthi.od2 -- generated by makeodt from dralthi.obj
;
; dralthi.obj uses dralthi.png as its texture.
; Note: if the engine doesn't accept PNG directly, convert dralthi.png to dralthi.tga
; and update the 'file' line below.
;
; Files to copy into your game data folder:
;   dralthi.od2     (from this folder)
;   dralthi.png     (from this folder, or dralthi.tga if converted)
;
; To use: exec dralthi.con  (from the in-game console)

write loading test: dralthi...

load texture dralthi.png    file dralthi.png
load object (dralthi)       file dralthi.od2 type ship_1

shipclass class (dralthi) texture mon_f1
shipclass class (dralthi)

shipdesc class (dralthi) caption dralthi

propc (dralthi).maxdamage     50
